APP_TITLE=Adobe Target MCP Reporting UI

ADOBE_TARGET_MCP_URL=https://targetmcp.adobe.io/mcp

# Authentication is interactive OAuth 2.0 (no static credentials). The loopback
# callback auto-picks a free port; the redirect URI is http://localhost:<port>/callback.
# Uncomment to pin a port or override the requested scopes.
# OAUTH_CALLBACK_PORT=8765
# OAUTH_SCOPE=AdobeID openid additional_info.projectedProductContext read_organizations additional_info.roles

# Defaults prefilled into form fields.
ADOBE_DEFAULT_ACTIVITY_ID=
ADOBE_DEFAULT_OFFER_ID=
ADOBE_DEFAULT_AUDIENCE_ID=
ADOBE_DEFAULT_MBOX_NAME=
# ISO 8601 range (start/end), e.g. 2026-05-01T00:00:00Z/2026-05-29T00:00:00Z.
# Blank uses the server's default window. Relative keywords are NOT accepted.
ADOBE_DEFAULT_REPORT_INTERVAL=
ADOBE_DEFAULT_LIMIT=10

# AI Query Simulator samples. Each maps a natural-language question to a tool
# name and a JSON argument payload. ARGS must be valid JSON on a single line.
SIM_QUERY_1_LABEL=Show active A/B activities
SIM_QUERY_1_TOOL=list_target_activities
SIM_QUERY_1_ARGS={"activity_type": "ab", "state": "approved", "limit": 10}

SIM_QUERY_2_LABEL=List content offers
SIM_QUERY_2_TOOL=list_target_offers
SIM_QUERY_2_ARGS={"type": "content", "limit": 10}

SIM_QUERY_3_LABEL=List all audiences
SIM_QUERY_3_TOOL=list_target_audiences
SIM_QUERY_3_ARGS={"limit": 10}

SIM_QUERY_4_LABEL=What can I target on?
SIM_QUERY_4_TOOL=list_target_mbox_profile_attributes
SIM_QUERY_4_ARGS={}

SIM_QUERY_5_LABEL=Show my paused activities
SIM_QUERY_5_TOOL=list_target_activities
SIM_QUERY_5_ARGS={"state": "paused", "limit": 10}

SIM_QUERY_6_LABEL=Show my Automated Personalization activities
SIM_QUERY_6_TOOL=list_target_activities
SIM_QUERY_6_ARGS={"activity_type": "abt", "limit": 10}

SIM_QUERY_7_LABEL=What properties do I have?
SIM_QUERY_7_TOOL=list_target_properties
SIM_QUERY_7_ARGS={}

SIM_QUERY_8_LABEL=Which response tokens are configured?
SIM_QUERY_8_TOOL=list_target_response_tokens
SIM_QUERY_8_ARGS={}

SIM_QUERY_9_LABEL=Show my mboxes
SIM_QUERY_9_TOOL=list_target_mboxes
SIM_QUERY_9_ARGS={"limit": 10}

SIM_QUERY_10_LABEL=Show redirect offers
SIM_QUERY_10_TOOL=list_target_offers
SIM_QUERY_10_ARGS={"type": "redirect", "limit": 10}

# Samples 1-10 are all zero-setup (no IDs required). To extend the simulator,
# add SIM_QUERY_11+ (the app reads indices up to 20). Two non-zero-setup ideas:
#
#   # Performance report — needs a real activity ID:
#   SIM_QUERY_11_LABEL=How is activity 12345 performing?
#   SIM_QUERY_11_TOOL=get_ab_performance_report
#   SIM_QUERY_11_ARGS={"activity_id": 12345}
#
#   # Revision history — its live schema requires both fields below
#   # (inspect it via Test Connection > List Tools / Schemas):
#   SIM_QUERY_12_LABEL=Who changed activities lately?
#   SIM_QUERY_12_TOOL=get_target_revisions
#   SIM_QUERY_12_ARGS={"revision_resource_type": "activity", "modified_by": "<user>"}
